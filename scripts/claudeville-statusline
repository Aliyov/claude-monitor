#!/bin/sh
# Claudeville status-line tee.
#
# Claude Code pipes a JSON status object to its status-line command. This
# script saves that JSON to a local file (no network, no tokens) so the
# monitor can read plan usage limits and context usage, then runs your
# previous status-line command (if you had one) so your status line looks
# exactly as before. With no previous command it prints nothing.
umask 077
dir="${XDG_STATE_HOME:-$HOME/.local/state}/claudeville/statusline"
[ -d "$dir" ] || mkdir -p "$dir" || exit 0
tmp="$dir/.in.$$"
cat > "$tmp" || { rm -f "$tmp"; exit 0; }
sid=$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9-]\{1,64\}\)".*/\1/p' "$tmp" | head -n 1)
if [ -n "$sid" ]; then
    out="$dir/$sid.json"
    mv -f "$tmp" "$out"
else
    out="$tmp"
fi
chain="${XDG_CONFIG_HOME:-$HOME/.config}/claudeville/statusline-chain"
if [ -s "$chain" ]; then
    sh -c "$(cat "$chain")" < "$out"
fi
[ "$out" = "$tmp" ] && rm -f "$tmp"
exit 0
